---
// A grid of linked cards, each an icon, a name and a line on what it does.
// The icons are drawn here rather than taken from Starlight's set, which is
// mostly brand marks with nothing for a radio, a compass or a route.
interface Item {
	icon: keyof typeof ICONS;
	title: string;
	text: string;
	href: string; // relative to the site base, or a full URL
}
interface Props {
	items: Item[];
}

const ICONS = {
	flight: '<path d="M21 3 3 10.5l7 2.5 2.5 7z"/><path d="m10 13 11-10"/>',
	mission:
		'<circle cx="5" cy="18" r="2"/><circle cx="19" cy="6" r="2"/><path d="M7 18h6a3 3 0 0 0 0-6h-2a3 3 0 0 1 0-6h6"/>',
	radio:
		'<path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="18" cy="18" r="2"/>',
	sensors: '<circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5z"/>',
	inspector: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="m7 9 3 3-3 3M13 15h4"/>',
	video: '<rect x="3" y="6" width="13" height="12" rx="2"/><path d="m16 10 5-3v10l-5-3z"/>',
	audio: '<path d="M4 9h4l5-4v14l-5-4H4z"/><path d="M16.5 9a4 4 0 0 1 0 6M19 6a8 8 0 0 1 0 12"/>',
	screens: '<rect x="2" y="4" width="20" height="13" rx="1.5"/><path d="M8 21h8M12 17v4"/>',
	plugins:
		'<rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><path d="M17 14v6M14 17h6"/>',
	themes: '<circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/>',
};

const { items } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<div class="grid not-content">
	{
		items.map(({ icon, title, text, href }) => (
			<a class="card" href={/^https?:/.test(href) ? href : `${base}${href}`}>
				<svg
					viewBox="0 0 24 24"
					width="26"
					height="26"
					fill="none"
					stroke="currentColor"
					stroke-width="1.6"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
					set:html={ICONS[icon]}
				/>
				<span class="title">{title}</span>
				<span class="text">{text}</span>
			</a>
		))
	}
</div>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
	}
	@media (max-width: 60rem) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 30rem) {
		.grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	.card {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.25rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: rgb(0 0 0 / 0.22);
		color: var(--sl-color-gray-2);
		text-decoration: none;
		transition: border-color 0.15s, background-color 0.15s;
	}
	.card:hover {
		border-color: var(--sl-color-accent);
		background: rgb(0 0 0 / 0.35);
	}
	svg {
		color: var(--sl-color-accent);
		margin-bottom: 0.25rem;
	}
	.title {
		color: var(--sl-color-white);
		font-weight: 600;
	}
	.text {
		font-size: var(--sl-text-sm);
		line-height: 1.5;
	}
</style>
