---
// The three downloads, each the latest release's installer for its OS, resolved
// at build time — see src/lib/release.ts.
//
// A press goes to that platform's install instructions, and the page there
// starts the download (DownloadNotice.astro). The link itself stays the file:
// without JavaScript, or opened in a new tab, it is a plain download.
import { Icon } from '@astrojs/starlight/components';
import { latestRelease, formatSize, RELEASES_URL, type Platform } from '../lib/release';

const rel = await latestRelease();
const base = import.meta.env.BASE_URL;

// `anchor` is the platform's heading on the install page.
const items: {
	platform: Platform;
	anchor: string;
	os: string;
	kind: string;
	targets: string;
	arch: string;
	icon: 'linux' | 'apple' | null;
}[] = [
	{
		platform: 'windows',
		anchor: 'windows',
		os: 'Windows',
		kind: 'Installer',
		targets: 'Windows',
		arch: 'x86-64',
		icon: null,
	},
	{
		platform: 'macos',
		anchor: 'macos',
		os: 'macOS',
		kind: 'Disk image',
		targets: 'Apple Silicon macOS',
		arch: 'ARM64',
		icon: 'apple',
	},
	{
		platform: 'linux',
		anchor: 'linux-ubuntu',
		os: 'Linux',
		kind: 'Debian package',
		targets: 'Debian-based OS',
		arch: 'x86-64',
		icon: 'linux',
	},
];
---

<div class="downloads not-content">
	{
		items.map(({ platform, anchor, os, kind, targets, arch, icon }) => (
			<a
				class="dl"
				href={rel[platform].url}
				rel="noopener"
				aria-label={`Download for ${os}`}
				data-install={`${base}start/install/?download=${platform}#${anchor}`}
			>
				<span class="dl-icon" aria-hidden="true">
					{icon ? (
						<Icon name={icon} size="6rem" />
					) : (
						<svg viewBox="0 0 24 24" width="96" height="96" fill="currentColor">
							<path d="M3 5.1 10 4v7H3zM11 3.9 21 2.5V11H11zM3 12h7v7l-7-1zM11 12h10v8.5l-10-1.4z" />
						</svg>
					)}
				</span>
				<span class="dl-kind">{kind}</span>
				<span class="dl-targets">{targets}</span>
				<span class="dl-specs">
					{arch}
					{rel[platform].size ? ` · ${formatSize(rel[platform].size)}` : ''}
				</span>
			</a>
		))
	}
	<p class="dl-meta">
		{rel.tag ? <>Latest release <a href={rel.page}>{rel.tag}</a> · </> : null}
		<a href={RELEASES_URL}>All releases</a>{' · '}
		<a href={`${base}start/install/`}>Install notes</a>
	</p>
</div>

<script>
	for (const a of document.querySelectorAll<HTMLAnchorElement>('a[data-install]')) {
		a.addEventListener('click', (e) => {
			// Ctrl-click and friends keep their meaning: the file, in a new tab.
			if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
			e.preventDefault();
			location.assign(a.dataset.install!);
		});
	}
</script>

<style>
	.downloads {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		margin-block: 1.5rem 0;
	}
	.dl {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
		padding: 0.5rem;
		text-align: center;
		color: var(--sl-color-white);
		text-decoration: none;
	}
	.dl-icon {
		color: var(--sl-color-accent);
		display: flex;
		margin-block-end: 0.5rem;
		transition: transform 0.15s, color 0.15s;
	}
	/* With no box to light up, the icon is what answers the pointer. */
	.dl:hover .dl-icon,
	.dl:focus-visible .dl-icon {
		color: var(--sl-color-accent-high);
		transform: scale(1.06);
	}
	.dl-kind {
		font-weight: 600;
	}
	.dl-targets {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
	}
	.dl-specs {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
	.dl-meta {
		grid-column: 1 / -1;
		margin: 0;
		text-align: center;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
	.dl-meta a {
		color: var(--sl-color-accent);
	}
	@media (max-width: 36rem) {
		.downloads {
			grid-template-columns: 1fr;
		}
	}
</style>
