---
// The landing page's top, in place of Starlight's two-column hero: the claim,
// a way into the docs, the downloads, and the app itself at full width. A tool
// sells on its screenshot, so that is what fills the first screen.
import { Image } from 'astro:assets';
import Downloads from './Downloads.astro';
import cap0 from '../../../screens/cap0.png';

const { title, tagline } = Astro.locals.starlightRoute.entry.data.hero ?? {};
const base = import.meta.env.BASE_URL;
---

<div class="hero not-content">
	<p class="eyebrow">Free Body Problem</p>
	<h1 id="_top" set:html={title} />
	{tagline && <p class="tagline" set:html={tagline} />}
	<p class="early" role="note">
		<span class="tag">Early development</span>
		Expect missing features, rough edges and changes between releases. Try it in SITL or on the
		bench before you trust it with an aircraft in flight.
	</p>
	<a class="start" href={`${base}start/install/`}>Get started <span aria-hidden="true">→</span></a>
	<div id="downloads" class="dl-anchor"><Downloads /></div>
	<p class="fine">Free and open source under the Apache 2.0 licence.</p>
	<Image
		src={cap0}
		alt="Free Body Problem in MAP + VIDEO: the video feed above the map, flight modes on the left, attitude, telemetry tiles and event log on the right"
		width={1600}
		loading="eager"
		class="shot"
	/>
</div>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding-block: 3rem 1rem;
	}
	.eyebrow {
		margin: 0;
		color: var(--sl-color-accent);
		font-family: var(--sl-font-mono);
		font-size: clamp(1.25rem, 2.6vw, 1.875rem);
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	h1 {
		margin: 1rem 0 0;
		max-width: 22ch;
		color: var(--sl-color-white);
		font-size: clamp(2.25rem, 5vw, 3.5rem);
		font-weight: 650;
		line-height: 1.08;
		letter-spacing: -0.02em;
	}
	.tagline {
		margin: 1.25rem 0 2rem;
		max-width: 44rem;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-xl);
		line-height: 1.5;
	}
	.start {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1.75rem;
		border-radius: 0.5rem;
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
		font-size: var(--sl-text-lg);
		font-weight: 650;
		text-decoration: none;
		transition: background-color 0.15s;
	}
	.start:hover {
		background: var(--sl-color-accent-high);
	}
	.dl-anchor {
		width: min(100%, 46rem);
		margin-top: 1rem;
		/* Clear the fixed header when the Downloads link scrolls here. */
		scroll-margin-top: calc(var(--sl-nav-height) + 1.5rem);
	}
	.hero :global(.downloads) {
		text-align: left;
	}
	.early {
		max-width: 46rem;
		margin: 0 0 1.75rem;
		padding: 0.75rem 1rem;
		border: 1px solid rgb(236 185 78 / 0.45);
		border-left-width: 3px;
		border-radius: 0.375rem;
		background: rgb(236 185 78 / 0.08);
		color: var(--sl-color-gray-1);
		font-size: var(--sl-text-sm);
		line-height: 1.55;
		text-align: left;
	}
	.tag {
		margin-right: 0.4rem;
		color: var(--sl-color-accent);
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.fine {
		margin: 1rem 0 0;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
	}
	.shot {
		display: block;
		width: 100%;
		height: auto;
		margin-top: 3.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		box-shadow: 0 2rem 5rem rgb(0 0 0 / 0.55);
	}
</style>
