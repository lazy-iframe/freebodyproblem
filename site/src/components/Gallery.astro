---
// A row of captioned screenshots, each linking to the page that explains it.
// Images go through astro:assets: resized to the width they are shown at and
// re-encoded as WebP, so the PNGs in screens/ stay full size for the README.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Item {
	src: ImageMetadata;
	alt: string;
	caption: string;
	href?: string;
}
interface Props {
	items: Item[];
	min?: string; // narrowest a column may get
}
const { items, min = '14rem' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<div class="gallery not-content" style={`--min:${min}`}>
	{
		items.map(({ src, alt, caption, href }) => {
			const img = <Image src={src} alt={alt} width={720} loading="lazy" decoding="async" />;
			return (
				<figure>
					{href ? <a href={`${base}${href}`}>{img}</a> : img}
					<figcaption>{caption}</figcaption>
				</figure>
			);
		})
	}
</div>

<style>
	.gallery {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(var(--min), 1fr));
		gap: 1.5rem;
		margin-block: 2rem 3rem;
	}
	figure {
		margin: 0;
	}
	img {
		width: 100%;
		height: auto;
		display: block;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.375rem;
		transition: border-color 0.15s;
	}
	a:hover img {
		border-color: var(--sl-color-accent);
	}
	figcaption {
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		text-align: center;
	}
</style>
